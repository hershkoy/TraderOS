//@version=6
// Lightweight overlay for one HTML fill (List of trades Channel JSON, or Manual rails).
// Not the live /hot detector (that is CTD). Runs once on the last bar in a short window.
// JSON times are UTC (unix ms). Pine has no JSON.parse; keys are scanned as text.
indicator("Channel Touch Fill Viewer", "CTF", overlay = true, max_bars_back = 5000, max_lines_count = 20, max_labels_count = 40)

gFill = "Fill"
gMan  = "Manual rails (from HTML / replay)"
gAuto = "Auto-detect (15m H2 window)"
gVis  = "Display"

channelJsonIn = input.text_area("", "Channel JSON", group = gFill, tooltip = "One paste from the HTML List of trades Channel column (i icon). Overrides Manual rails when l1p/l2p/w are present. Times are UTC.")
drawMode = input.string("Manual rails", "Draw mode", options = ["Manual rails", "Auto-detect 15m H2"], group = gFill, tooltip = "Used only when Channel JSON is empty. Manual = L1/L2/width inputs. Auto = find H2 in Window bars before Fill time (last bar only).")
fillTimeIn = input.time(timestamp("10 Jun 2025 09:30"), "Fill time (chart TZ)", group = gFill, tooltip = "Chart timezone. Ignored when Channel JSON has fill_ms. HTML 2025-06-10 13:30 UTC = 09:30 ET on NASDAQ 15m.")

tL1 = input.time(timestamp("4 Jun 2025 13:00"), "L1 time", group = gMan)
pL1 = input.float(35.63, "L1 price", step = 0.01, group = gMan)
tL2 = input.time(timestamp("9 Jun 2025 09:30"), "L2 time", group = gMan)
pL2 = input.float(37.02, "L2 price", step = 0.01, group = gMan)
widthIn = input.float(1.0459, "Channel width (price)", step = 0.0001, group = gMan)
tH2 = input.time(timestamp("9 Jun 2025 13:00"), "H2 time (label)", group = gMan)

windowBars = input.int(390, "Window bars before fill", minval = 80, maxval = 780, group = gAuto, tooltip = "15m scaled scan window (15 RTH sessions). Do not use the full chart.")
minWait = input.int(12, "Min wait bars", minval = 1, group = gAuto)
errorPct = input.float(0.24, "Touch error %", step = 0.01, group = gAuto)
dbgLog = input.bool(true, "Last-bar Pine logs", group = gAuto, tooltip = "A few log.info lines on the last bar only. Open Pine Editor > ... > Pine logs. Not a per-bar log.")

supportColor = input.color(#26a69a, "Support", group = gVis)
resistColor  = input.color(#ef5350, "Resistance", group = gVis)
fillColor    = input.color(color.new(#26a69a, 88), "Fill", group = gVis)
showTable    = input.bool(true, "Info table", group = gVis)

var array<line> drawnLines = array.new_line()
var array<label> drawnLabs = array.new_label()
var array<linefill> drawnFills = array.new_linefill()
// top_left: top_right sits under the watchlist and looks like "no rails / no status"
var table info = table.new(position.top_left, 2, 10, bgcolor = color.new(#111111, 10), border_width = 1, border_color = color.new(#ffffff, 70))

// Oldest / newest loaded bar times (within max_bars_back).
f_first_bar_time() =>
    int t0 = int(na)
    lim = math.min(bar_index, 4999)
    if lim >= 0
        t0 := time[lim]
    t0

// Project channel segment onto loaded bars so 1d JSON still shows on 15m.
// mode: exact | clipped | projected
f_project_seg(int tL1, float yL1, float slopeMs, int tRightWanted, int tFirst, int tLast) =>
    int tLeft = tL1
    int tRight = tRightWanted
    string mode = "exact"
    if na(tFirst) or na(tLast) or tLast <= tFirst
        float yL = yL1
        float yR = yL1 + slopeMs * (tRightWanted - tL1)
        [tLeft, yL, tRight, yR, mode]
    else
        // Ideal clip to loaded window
        tLeft := math.max(tL1, tFirst)
        tRight := math.min(tRightWanted, tLast)
        if tRight <= tLeft
            // Entire trade outside loaded history: still draw across what is on chart
            tLeft := tFirst
            tRight := tLast
            mode := "projected"
        else if tLeft > tL1 or tRight < tRightWanted
            mode := "clipped"
        float yL = yL1 + slopeMs * (tLeft - tL1)
        float yR = yL1 + slopeMs * (tRight - tL1)
        [tLeft, yL, tRight, yR, mode]

f_clear() =>
    nF = array.size(drawnFills)
    if nF > 0
        for i = 0 to nF - 1
            linefill.delete(array.get(drawnFills, i))
        array.clear(drawnFills)
    nL = array.size(drawnLines)
    if nL > 0
        for i = 0 to nL - 1
            line.delete(array.get(drawnLines, i))
        array.clear(drawnLines)
    nB = array.size(drawnLabs)
    if nB > 0
        for i = 0 to nB - 1
            label.delete(array.get(drawnLabs, i))
        array.clear(drawnLabs)

f_asof_off(int ts) =>
    found = int(na)
    lim = math.min(bar_index, 4999)
    if lim >= 0
        for i = 0 to lim
            t = time[i]
            if na(t)
                break
            if t <= ts
                found := i
                break
    found

f_lab(int t, float y, string txt, string sty, color bg) =>
    // Snap off-history times onto the nearest loaded bar so labels still show on 15m.
    int off = f_asof_off(t)
    int tFirst = f_first_bar_time()
    if na(off) and not na(tFirst) and t < tFirst
        off := f_asof_off(tFirst)
    if na(off) and t > time
        off := 0
    if na(off)
        lab = label.new(t, y, txt, xloc = xloc.bar_time, style = sty, color = bg, textcolor = color.white, size = size.tiny)
        array.push(drawnLabs, lab)
    else
        lab = label.new(bar_index - off, y, txt, xloc = xloc.bar_index, style = sty, color = bg, textcolor = color.white, size = size.tiny)
        array.push(drawnLabs, lab)

f_draw(int t1, float y1, int t2, float y2, float width, string tag) =>
    f_clear()
    int o1 = f_asof_off(t1)
    int o2 = f_asof_off(t2)
    // bar_index is reliable; bar_time endpoints before/between bars often draw nothing on TV.
    if not na(o1) and not na(o2) and o1 >= o2
        int x1 = bar_index - o1
        int x2 = bar_index - o2
        if x2 <= x1
            x2 := x1 + 1
        lnBot = line.new(x1, y1, x2, y2, xloc = xloc.bar_index, extend = extend.right, color = supportColor, width = 2)
        lnTop = line.new(x1, y1 + width, x2, y2 + width, xloc = xloc.bar_index, extend = extend.right, color = resistColor, width = 2)
        array.push(drawnLines, lnBot)
        array.push(drawnLines, lnTop)
        array.push(drawnFills, linefill.new(lnBot, lnTop, fillColor))
        if tag != ""
            labFill = label.new(x2, y2 + width, tag, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(resistColor, 10), textcolor = color.white, size = size.small)
            array.push(drawnLabs, labFill)
    else
        lnBot = line.new(t1, y1, t2, y2, xloc = xloc.bar_time, extend = extend.right, color = supportColor, width = 2)
        lnTop = line.new(t1, y1 + width, t2, y2 + width, xloc = xloc.bar_time, extend = extend.right, color = resistColor, width = 2)
        array.push(drawnLines, lnBot)
        array.push(drawnLines, lnTop)
        array.push(drawnFills, linefill.new(lnBot, lnTop, fillColor))
        if tag != ""
            labFill = label.new(t2, y2 + width, tag, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(resistColor, 10), textcolor = color.white, size = size.small)
            array.push(drawnLabs, labFill)

f_same_day(int t1, int t2) =>
    year(t1) == year(t2) and month(t1) == month(t2) and dayofmonth(t1) == dayofmonth(t2)

f_tbl(string title, string fillT, string status, string tone, string sup, string res, string wid, string wait, string note, string how) =>
    if showTable
        lab = #ffffff
        sz = size.small
        stCol = tone == "ok" ? supportColor : color.yellow
        table.cell(info, 0, 0, "CTF", text_color = lab, text_size = sz)
        table.cell(info, 1, 0, title, text_color = lab, text_size = sz)
        table.cell(info, 0, 1, "Fill time", text_color = lab, text_size = sz)
        table.cell(info, 1, 1, fillT, text_color = lab, text_size = sz)
        table.cell(info, 0, 2, "Status", text_color = lab, text_size = sz)
        table.cell(info, 1, 2, status, text_color = stCol, text_size = sz)
        table.cell(info, 0, 3, "Support", text_color = lab, text_size = sz)
        table.cell(info, 1, 3, sup, text_color = supportColor, text_size = sz)
        table.cell(info, 0, 4, "Resist", text_color = lab, text_size = sz)
        table.cell(info, 1, 4, res, text_color = resistColor, text_size = sz)
        table.cell(info, 0, 5, "Width", text_color = lab, text_size = sz)
        table.cell(info, 1, 5, wid, text_color = lab, text_size = sz)
        table.cell(info, 0, 6, "Wait", text_color = lab, text_size = sz)
        table.cell(info, 1, 6, wait, text_color = lab, text_size = sz)
        table.cell(info, 0, 7, "Note", text_color = lab, text_size = sz)
        table.cell(info, 1, 7, note, text_color = lab, text_size = sz)
        table.cell(info, 0, 8, "How", text_color = lab, text_size = sz)
        table.cell(info, 1, 8, how, text_color = lab, text_size = sz)
        table.cell(info, 0, 9, "", text_color = lab, text_size = sz)
        table.cell(info, 1, 9, "", text_color = lab, text_size = sz)

f_norm_json(string src) =>
    s = str.replace_all(src, "\n", "")
    s := str.replace_all(s, "\r", "")
    s := str.replace_all(s, " ", "")
    s

f_jraw(string src, string key) =>
    string needle = '"' + key + '":'
    int p = str.pos(src, needle)
    string out = string(na)
    if not na(p)
        int i = p + str.length(needle)
        int n = str.length(src)
        if i < n and str.substring(src, i, i + 1) == '"'
            int j = i + 1
            int endq = j
            for k = 0 to 48
                if j >= n
                    break
                if str.substring(src, j, j + 1) == '"'
                    endq := j
                    break
                j += 1
            out := str.substring(src, i + 1, endq)
        else
            int j = i
            int endn = i
            // ms timestamps are 13 digits; allow headroom for decimals/sign
            for k = 0 to 40
                if j >= n
                    break
                string c = str.substring(src, j, j + 1)
                if c == "," or c == "}"
                    endn := j
                    break
                j += 1
                endn := j
            out := str.substring(src, i, endn)
    out

f_jnum(string src, string key) =>
    str.tonumber(f_jraw(src, key))

f_jstr(string src, string key) =>
    f_jraw(src, key)

f_iso_ms(string s) =>
    int ms = int(na)
    if not na(s) and str.length(s) >= 10
        int y = int(str.tonumber(str.substring(s, 0, 4)))
        int mo = int(str.tonumber(str.substring(s, 5, 7)))
        int d = int(str.tonumber(str.substring(s, 8, 10)))
        int h = 0
        int mi = 0
        if str.length(s) >= 16
            h := int(str.tonumber(str.substring(s, 11, 13)))
            mi := int(str.tonumber(str.substring(s, 14, 16)))
        ms := timestamp("UTC", y, mo, d, h, mi)
    ms

f_ms(string src, string msKey, string tKey) =>
    float n = f_jnum(src, msKey)
    int ms = int(na)
    if not na(n)
        ms := int(n)
    else
        ms := f_iso_ms(f_jstr(src, tKey))
    ms

// Every bar: project sloping rails from JSON/Manual onto this timeframe (1d JSON works on 15m).
jsonSrcPlot = f_norm_json(channelJsonIn)
useJsonPlot = str.length(jsonSrcPlot) >= 20 and str.contains(jsonSrcPlot, '"l1p"')
float railSup = na
float railRes = na
if useJsonPlot
    l1pP = f_jnum(jsonSrcPlot, "l1p")
    l2pP = f_jnum(jsonSrcPlot, "l2p")
    wP = f_jnum(jsonSrcPlot, "w")
    tL1P = f_ms(jsonSrcPlot, "l1_ms", "l1t")
    tL2P = f_ms(jsonSrcPlot, "l2_ms", "l2t")
    symP = f_jstr(jsonSrcPlot, "sym")
    tickerPlotOk = true
    if not na(symP)
        tickerPlotOk := str.upper(symP) == str.upper(syminfo.ticker)
    if tickerPlotOk and not na(l1pP) and not na(l2pP) and not na(wP) and wP > 0 and not na(tL1P) and not na(tL2P) and tL2P != tL1P
        slopeP = (l2pP - l1pP) / (tL2P - tL1P)
        railSup := l1pP + slopeP * (time - tL1P)
        railRes := railSup + wP
else if drawMode == "Manual rails" and pL1 > 0 and pL2 > 0 and widthIn > 0 and tL2 != tL1
    slopeP = (pL2 - pL1) / (tL2 - tL1)
    railSup := pL1 + slopeP * (time - tL1)
    railRes := railSup + widthIn

pSup = plot(railSup, "CTF support", color = supportColor, linewidth = 2)
pRes = plot(railRes, "CTF resist", color = resistColor, linewidth = 2)
fill(pSup, pRes, color = fillColor, title = "CTF channel")

if barstate.islast
    jsonSrc = f_norm_json(channelJsonIn)
    useJson = str.length(jsonSrc) >= 20 and str.contains(jsonSrc, '"l1p"')
    fillTxt = str.format_time(fillTimeIn, "yyyy-MM-dd HH:mm")
    if useJson
        l1p = f_jnum(jsonSrc, "l1p")
        l2p = f_jnum(jsonSrc, "l2p")
        widthJ = f_jnum(jsonSrc, "w")
        tL1j = f_ms(jsonSrc, "l1_ms", "l1t")
        tL2j = f_ms(jsonSrc, "l2_ms", "l2t")
        tH2j = f_ms(jsonSrc, "h2_ms", "h2t")
        tFj = f_ms(jsonSrc, "fill_ms", "fill")
        tEnj = f_ms(jsonSrc, "en_ms", "en")
        tExj = f_ms(jsonSrc, "ex_ms", "ex")
        enp = f_jnum(jsonSrc, "enp")
        exp = f_jnum(jsonSrc, "exp")
        symJ = f_jstr(jsonSrc, "sym")
        srcJ = f_jstr(jsonSrc, "src")
        fillUse = na(tEnj) ? (na(tFj) ? fillTimeIn : tFj) : tEnj
        fillTxtJ = str.format_time(fillUse, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
        h2Use = na(tH2j) ? tL2j : tH2j
        tickerOk = true
        if not na(symJ)
            tickerOk := str.upper(symJ) == str.upper(syminfo.ticker)
        if not tickerOk
            f_clear()
            f_tbl("json", fillTxtJ, "wrong symbol", "err", "-", "-", "-", "-", "JSON sym=" + symJ, "Switch chart to " + symJ)
            if dbgLog
                log.info("CTF json: chart={0} json sym={1}", syminfo.ticker, symJ)
        else if na(l1p) or na(l2p) or na(widthJ) or widthJ <= 0 or na(tL1j) or na(tL2j) or tL2j == tL1j
            f_clear()
            f_tbl("json", fillTxtJ, "bad JSON", "err", "-", "-", "-", "-", "Need l1p l2p w l1_ms l2_ms fill_ms", "Copy from HTML Channel i")
            if dbgLog
                log.info("CTF json: missing rails")
        else
            slopeMs = (l2p - l1p) / (tL2j - tL1j)
            tRightWanted = fillUse
            if not na(tExj)
                tRightWanted := math.max(fillUse, tExj)
            tFirst = f_first_bar_time()
            tLast = time
            [tLeft, yLeft, tRight, yRight, projMode] = f_project_seg(tL1j, l1p, slopeMs, tRightWanted, tFirst, tLast)
            yFill = l1p + slopeMs * (fillUse - tL1j)
            f_draw(tLeft, yLeft, tRight, yRight, widthJ, "")
            // Pivot labels only when that stamp lands on loaded bars (or snaps to edge).
            if projMode != "projected"
                if tL1j >= tLeft
                    f_lab(tL1j, l1p, "L1", label.style_label_up, supportColor)
                else
                    f_lab(tLeft, yLeft, "L1(clip)", label.style_label_up, supportColor)
                if tL2j >= tLeft and tL2j <= tRight
                    f_lab(tL2j, l2p, "L2", label.style_label_up, supportColor)
                if not na(h2Use) and h2Use >= tLeft and h2Use <= tRight
                    f_lab(h2Use, l1p + slopeMs * (h2Use - tL1j) + widthJ, "H2", label.style_label_down, resistColor)
            else
                f_lab(tLeft, yLeft, "rail(proj)", label.style_label_up, supportColor)
            // BUY/SELL: snap onto chart even when fill is older than loaded 15m.
            if not na(enp)
                f_lab(fillUse, enp, (projMode == "projected" ? "BUY off-chart " : "BUY ") + str.tostring(enp, "#.00"), label.style_label_up, supportColor)
            else
                f_lab(fillUse, yFill + widthJ, projMode == "projected" ? "FILL off-chart" : "FILL", label.style_label_left, color.new(resistColor, 10))
            if not na(tExj) and not na(exp)
                f_lab(tExj, exp, (projMode == "projected" ? "SELL off-chart " : "SELL ") + str.tostring(exp, "#.00"), label.style_label_down, resistColor)
            barMs = math.max(1, timeframe.in_seconds() * 1000)
            waitEst = int(math.round((fillUse - h2Use) / float(barMs)))
            noteJ = (na(srcJ) ? "html json" : srcJ)
            if not na(enp)
                noteJ := noteJ + " BUY " + str.tostring(enp, "#.00")
            if not na(exp)
                noteJ := noteJ + " SELL " + str.tostring(exp, "#.00")
            if projMode == "projected"
                noteJ := noteJ + " rails projected onto loaded " + timeframe.period
            else if projMode == "clipped"
                noteJ := noteJ + " L1/fill clipped to chart history"
            statusJ = projMode == "exact" ? "drawn" : (projMode == "clipped" ? "drawn (clipped)" : "drawn (projected)")
            howJ = "CTF JSON paste"
            f_tbl("json", fillTxtJ, statusJ, "ok", str.tostring(yFill, "#.00"), str.tostring(yFill + widthJ, "#.00"), str.tostring(widthJ, "#.000"), str.tostring(waitEst) + " bars (H2 to fill)", noteJ, howJ)
            if dbgLog
                log.info("CTF json fill={0} support={1} resist={2} sym={3} mode={4}", fillTxtJ, yFill, yFill + widthJ, na(symJ) ? "-" : symJ, projMode)
    else if str.length(jsonSrc) >= 2
        f_clear()
        f_tbl("json", fillTxt, "bad JSON", "err", "-", "-", "-", "-", "Need keys l1p l2p w", "Copy from HTML Channel i")
        if dbgLog
            log.info("CTF json: paste missing l1p")
    else if drawMode == "Manual rails"
        if pL1 <= 0 or pL2 <= 0 or widthIn <= 0 or tL2 == tL1
            f_clear()
            f_tbl("manual", fillTxt, "bad inputs", "err", "-", "-", "-", "-", "L1/L2/width required", "Use Auto-detect or paste HTML rails")
            if dbgLog
                log.info("CTF manual: bad L1/L2/width")
        else
            slopeMs = (pL2 - pL1) / (tL2 - tL1)
            yFill = pL1 + slopeMs * (fillTimeIn - tL1)
            tFirst = f_first_bar_time()
            [tLeft, yLeft, tRight, yRight, projMode] = f_project_seg(tL1, pL1, slopeMs, fillTimeIn, tFirst, time)
            f_draw(tLeft, yLeft, tRight, yRight, widthIn, "")
            if projMode != "projected"
                f_lab(tL1, pL1, "L1", label.style_label_up, supportColor)
                f_lab(tL2, pL2, "L2", label.style_label_up, supportColor)
                f_lab(tH2, pL1 + slopeMs * (tH2 - tL1) + widthIn, "H2", label.style_label_down, resistColor)
                f_lab(fillTimeIn, yFill + widthIn, "FILL", label.style_label_left, color.new(resistColor, 10))
            else
                f_lab(tLeft, yLeft, "rail(proj)", label.style_label_up, supportColor)
                f_lab(fillTimeIn, yFill + widthIn, "FILL off-chart", label.style_label_left, color.new(resistColor, 10))
            barMs = math.max(1, timeframe.in_seconds() * 1000)
            waitEst = int(math.round((fillTimeIn - tH2) / float(barMs)))
            statusM = projMode == "exact" ? "drawn" : (projMode == "clipped" ? "drawn (clipped)" : "drawn (projected)")
            noteM = projMode == "projected" ? "rails projected onto loaded " + timeframe.period : "HTML rails, not a live scan"
            f_tbl("manual 15m H5", fillTxt, statusM, "ok", str.tostring(yFill, "#.00"), str.tostring(yFill + widthIn, "#.00"), str.tostring(widthIn, "#.000"), str.tostring(waitEst) + " bars (H2 to fill)", noteM, "CTD stays for /hot overlay")
            if dbgLog
                log.info("CTF manual fill={0} support={1} resist={2} mode={3}", fillTxt, yFill, yFill + widthIn, projMode)
    else
        asofOff = f_asof_off(fillTimeIn)
        if na(asofOff)
            f_clear()
            f_tbl("auto 15m H2", fillTxt, "fill bar not in history", "err", "-", "-", "-", "-", "Scroll/load more 15m bars", "Or use Manual rails")
            if dbgLog
                log.info("CTF auto: fill time not on chart {0}", fillTxt)
        else
            win = math.min(windowBars, asofOff + 1)
            hArr = array.new_float()
            lArr = array.new_float()
            cArr = array.new_float()
            tArr = array.new_int()
            vArr = array.new_float()
            for j = 0 to win - 1
                off = asofOff - (win - 1 - j)
                array.push(hArr, high[off])
                array.push(lArr, low[off])
                array.push(cArr, close[off])
                array.push(tArr, time[off])
                array.push(vArr, volume[off])
            asof = win - 1
            pivot = 8
            minBars = 8
            flatPct = 0.0015
            risePctMin = 0.59
            rallyMin = 0.78
            pullMin = 0.59
            maxPiv = 24
            maxSpanD = 10.0
            lowX = array.new_int()
            lowY = array.new_float()
            highX = array.new_int()
            highY = array.new_float()
            if asof >= 2 * pivot
                for p = pivot to asof - pivot
                    plo = true
                    phi = true
                    pxL = array.get(lArr, p)
                    pxH = array.get(hArr, p)
                    for k = 1 to pivot
                        if array.get(lArr, p - k) < pxL or array.get(lArr, p + k) < pxL
                            plo := false
                        if array.get(hArr, p - k) > pxH or array.get(hArr, p + k) > pxH
                            phi := false
                    if plo
                        array.push(lowX, p)
                        array.push(lowY, pxL)
                        if array.size(lowX) > maxPiv
                            array.shift(lowX)
                            array.shift(lowY)
                    if phi
                        array.push(highX, p)
                        array.push(highY, pxH)
                        if array.size(highX) > maxPiv * 2
                            array.shift(highX)
                            array.shift(highY)
            nL = array.size(lowX)
            nH = array.size(highX)
            bestH2 = int(na)
            bestX1 = 0
            bestY1 = 0.0
            bestSlope = 0.0
            bestW = 0.0
            bestFillI = int(na)
            bestSt = "none"
            nDet = 0
            if nL >= 2 and nH >= 2
                for c = nL - 1 to 1
                    for a = c - 1 to 0
                        x1 = array.get(lowX, a)
                        y1 = array.get(lowY, a)
                        xn = array.get(lowX, c)
                        yn = array.get(lowY, c)
                        if xn - x1 < minBars or y1 <= 0 or yn <= 0
                            continue
                        slope = (yn - y1) / float(xn - x1)
                        if slope <= 0 or (slope / y1 * 100.0) < flatPct or (yn - y1) / y1 * 100.0 < risePctMin
                            continue
                        if math.abs((y1 + slope * (xn - x1)) - yn) / yn * 100.0 > errorPct
                            continue
                        peak = array.get(hArr, x1 + 1)
                        if xn - 1 > x1 + 1
                            for i = x1 + 2 to xn - 1
                                peak := math.max(peak, array.get(hArr, i))
                        if (peak - y1) / y1 * 100.0 < rallyMin
                            continue
                        widths = array.new_float()
                        nInside = 0
                        nAfter = 0
                        if nH > 0
                            for hi = 0 to nH - 1
                                xh = array.get(highX, hi)
                                if xh > x1 and xh < xn
                                    nInside += 1
                                else if xh > xn
                                    nAfter += 1
                                if xh > x1
                                    dist = array.get(highY, hi) - (y1 + slope * (xh - x1))
                                    if dist > 0
                                        array.push(widths, dist)
                        if nInside < 1 or nAfter < 1 or array.size(widths) < 2
                            continue
                        nw = array.size(widths)
                        if nw > 1
                            for i = 1 to nw - 1
                                key = array.get(widths, i)
                                j = i - 1
                                while j >= 0 and array.get(widths, j) > key
                                    array.set(widths, j + 1, array.get(widths, j))
                                    j -= 1
                                array.set(widths, j + 1, key)
                        chosenW = float(na)
                        h2x = int(na)
                        for wi = 0 to nw - 1
                            w = array.get(widths, wi)
                            cand = array.new_int()
                            for hi = 0 to nH - 1
                                xh = array.get(highX, hi)
                                if xh <= x1
                                    continue
                                yTop = y1 + slope * (xh - x1) + w
                                yh = array.get(highY, hi)
                                if math.abs(yTop - yh) / yh * 100.0 <= errorPct * 1.25
                                    array.push(cand, xh)
                            hasAfter = false
                            nc = array.size(cand)
                            if nc > 0
                                for ci = 0 to nc - 1
                                    if array.get(cand, ci) > xn
                                        hasAfter := true
                                        break
                            if not hasAfter or nc < 2
                                continue
                            filt = array.new_int()
                            array.push(filt, array.get(cand, 0))
                            if nc > 1
                                for ci = 1 to nc - 1
                                    xh = array.get(cand, ci)
                                    prevH = array.get(filt, array.size(filt) - 1)
                                    if xh - prevH < minBars
                                        continue
                                    resistPrev = y1 + slope * (prevH - x1) + w
                                    trough = array.get(lArr, prevH + 1)
                                    if xh - 1 > prevH + 1
                                        for i = prevH + 2 to xh - 1
                                            trough := math.min(trough, array.get(lArr, i))
                                    if resistPrev > 0 and (resistPrev - trough) / resistPrev * 100.0 >= pullMin
                                        array.push(filt, xh)
                            if array.size(filt) < 2
                                continue
                            h2Cand = int(na)
                            for ui = 0 to array.size(filt) - 1
                                h = array.get(filt, ui)
                                if h <= xn
                                    continue
                                if ui + 1 >= 2
                                    h2Cand := h
                                    break
                            if na(h2Cand)
                                continue
                            spanD = (array.get(tArr, h2Cand) - array.get(tArr, x1)) / 86400000.0
                            if spanD > maxSpanD
                                continue
                            chosenW := w
                            h2x := h2Cand
                            break
                        if na(chosenW) or na(h2x) or h2x >= asof
                            continue
                        nDet += 1
                        st = "armed"
                        fillI = int(na)
                        wait = asof - h2x
                        if wait < minWait
                            st := "waiting"
                        if wait > 252
                            st := "expired"
                        else
                            end = math.min(asof, h2x + 252)
                            for i = h2x + 1 to end
                                if st != "waiting" and st != "armed"
                                    break
                                sup = y1 + slope * (i - x1)
                                resist = sup + chosenW
                                if i > 0 and array.get(cArr, i - 1) < (y1 + slope * (i - 1 - x1)) * (1.0 - errorPct / 100.0)
                                    st := "cancelled"
                                    break
                                close_i = array.get(cArr, i)
                                if close_i > resist * (1.0 + errorPct / 100.0)
                                    if i >= h2x + minWait
                                        fillI := i
                                        st := i < asof ? "filled_earlier" : "filled"
                                        break
                                else
                                    supTol = errorPct / 100.0
                                    lo = array.get(lArr, i)
                                    hi = array.get(hArr, i)
                                    touched = lo <= sup * (1.0 + supTol) and hi >= sup * (1.0 - supTol) and hi >= sup and close_i >= sup * (1.0 - supTol)
                                    broke = close_i < sup * (1.0 - supTol)
                                    if i < h2x + minWait
                                        if touched or broke
                                            st := "cancelled"
                                            break
                                    else if broke
                                        st := "cancelled"
                                        break
                        hit = st == "filled" or (st == "filled_earlier" and not na(fillI) and f_same_day(array.get(tArr, fillI), fillTimeIn))
                        if hit and (na(bestH2) or h2x >= bestH2)
                            bestH2 := h2x
                            bestX1 := x1
                            bestY1 := y1
                            bestSlope := slope
                            bestW := chosenW
                            bestFillI := fillI
                            bestSt := st
            if dbgLog
                log.info("CTF auto asofOff={0} win={1} nL={2} nH={3} nDet={4} st={5}", asofOff, win, nL, nH, nDet, bestSt)
            if na(bestH2)
                f_clear()
                f_tbl("auto 15m H2", fillTxt, "no fill in window", "err", "-", "-", "-", str.tostring(nDet) + " H2 tried", "Switch to Manual rails", "Window=" + str.tostring(win))
            else
                fillI = na(bestFillI) ? asof : bestFillI
                y1 = bestY1
                x1 = bestX1
                yFillSup = y1 + bestSlope * (fillI - x1)
                t1 = array.get(tArr, x1)
                tF = array.get(tArr, fillI)
                f_draw(t1, y1, tF, yFillSup, bestW, "FILL")
                f_lab(t1, y1, "L1", label.style_label_up, supportColor)
                waitBars = fillI - bestH2
                f_tbl("auto 15m H2", fillTxt, bestSt, "ok", str.tostring(yFillSup, "#.00"), str.tostring(yFillSup + bestW, "#.00"), str.tostring(bestW, "#.000"), str.tostring(waitBars) + "/" + str.tostring(minWait), str.tostring(nDet) + " H2 in window", "H5 vol/overshoot not gated here")

//@version=6
// Momentum Squeeze Scalp (Alex Carter claim-check).
// 3-minute crypto. Close-confirmed Keltner break + CMO sign + relative volume.
// Fill is the next bar open. First half exits at 1:1; the rest trails the Keltner midline.
// 5x is percent-of-equity 500 with 20% margin. This does not model liquidation or funding.
strategy("Momentum Squeeze Scalp", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=500,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=0,
     pyramiding=0,
     margin_long=20,
     margin_short=20,
     process_orders_on_close=false,
     calc_on_every_tick=false)

kcLen = input.int(20, "Keltner length")
kcMult = input.float(1.5, "Keltner multiplier", step=0.1)
cmoLen = input.int(14, "CMO length")
rvLen = input.int(20, "Relative volume length")
rvMin = input.float(1.5, "Relative volume minimum", step=0.1)
stopBufAtr = input.float(0.1, "Stop buffer beyond midline (ATR)", step=0.05)
scalePct = input.float(50.0, "Scale-out percent at 1:1", minval=1.0, maxval=99.0)

[basis, upper, lower] = ta.kc(close, kcLen, kcMult, true)
atr = ta.atr(kcLen)
cmo = ta.cmo(close, cmoLen)
rvAvg = ta.sma(volume, rvLen)[1]
rv = rvAvg > 0 ? volume / rvAvg : 0.0
buf = stopBufAtr * atr

longSig = close > upper and cmo > 0 and rv >= rvMin and close > open
shortSig = close < lower and cmo < 0 and rv >= rvMin and close < open

var float armStop = na

flat = strategy.position_size == 0
if longSig and not shortSig and flat
    armStop := basis - buf
    strategy.entry("Long", strategy.long, comment="MSS long")
if shortSig and not longSig and flat
    armStop := basis + buf
    strategy.entry("Short", strategy.short, comment="MSS short")

var float initStop = na
var float tp1 = na
var bool partialDone = false
var float trailStop = na

justLong = strategy.position_size > 0 and strategy.position_size[1] <= 0
justShort = strategy.position_size < 0 and strategy.position_size[1] >= 0

if justLong or justShort
    float fill = strategy.position_avg_price
    initStop := armStop
    bool invalid = (justLong and fill <= initStop) or (justShort and fill >= initStop)
    float risk = math.abs(fill - initStop)
    tp1 := justLong ? fill + risk : fill - risk
    trailStop := initStop
    partialDone := false
    if invalid or risk <= syminfo.mintick
        strategy.close_all(comment="invalid stop")

stillIn = strategy.position_size != 0 and strategy.position_size[1] != 0 and math.sign(strategy.position_size) == math.sign(strategy.position_size[1])
shrunk = stillIn and math.abs(strategy.position_size) < math.abs(strategy.position_size[1]) * 0.75
if shrunk
    partialDone := true

if strategy.position_size == 0
    partialDone := false

if strategy.position_size > 0 and not na(initStop)
    if partialDone
        strategy.cancel("L-half")
        float midStop = basis - buf
        trailStop := math.max(nz(trailStop, initStop), midStop)
        strategy.exit("L-run", from_entry="Long", stop=trailStop, comment_loss="mid trail")
    else
        strategy.exit("L-half", from_entry="Long", qty_percent=scalePct, limit=tp1, stop=initStop, comment_profit="1:1", comment_loss="mid stop")
        strategy.exit("L-run", from_entry="Long", stop=initStop, comment_loss="mid stop")

if strategy.position_size < 0 and not na(initStop)
    if partialDone
        strategy.cancel("S-half")
        float midStop = basis + buf
        trailStop := math.min(nz(trailStop, initStop), midStop)
        strategy.exit("S-run", from_entry="Short", stop=trailStop, comment_loss="mid trail")
    else
        strategy.exit("S-half", from_entry="Short", qty_percent=scalePct, limit=tp1, stop=initStop, comment_profit="1:1", comment_loss="mid stop")
        strategy.exit("S-run", from_entry="Short", stop=initStop, comment_loss="mid stop")

plot(basis, "KC mid", color=color.new(color.orange, 0))
plot(upper, "KC upper", color=color.new(color.teal, 0))
plot(lower, "KC lower", color=color.new(color.teal, 0))
plot(strategy.position_size > 0 ? trailStop : na, "Long stop", color=color.red, style=plot.style_linebr)
plot(strategy.position_size < 0 ? trailStop : na, "Short stop", color=color.red, style=plot.style_linebr)
plotshape(longSig and flat, title="Long signal", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(shortSig and flat, title="Short signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)

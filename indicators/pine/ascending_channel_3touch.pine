//@version=6
// Visual port of scripts/research/find_ascending_channels.py
//   Classic 3L/2H = find_channels v1 (unchanged in Python; quality via post-filters).
//   H2 arm 2L/2H  = find_h2_l3_setups (live /hot rails: L1-H1-L2-H2, no L3 required).
//
// Daily defaults: pivot 15, >=3 higher lows, >=2 parallel highs, error 1.2%,
// min slope 0.04%/bar, min rise 3%, rally 4%, pullback 3%, max viol 0.08,
// last 16 swing lows, first-valid greedy.
// 15m scaled: --preset 15m / live scanner (pivot 8, error 0.24%, rally 0.78%,
// pullback 0.59%, rise 0.59%, slope 0.0015%/bar, 24 lows, span 10d).
// Intervening rally/pullback use stored bar OHLC (not only pivot extrema).
indicator("Channel Touch Detector", "CTD", overlay = true, max_lines_count = 100, max_labels_count = 200)

gDet = "Detector"
gVis = "Display"

setupMode        = input.string("Classic 3L/2H", "Setup mode", options = ["Classic 3L/2H", "H2 arm 2L/2H"], group = gDet, tooltip = "Classic = find_channels v1 (>=3 lows, highs between L1 and last low). H2 arm = find_h2_l3_setups used by /hot (support on L1-L2, H2 after L2 completes the parallel).")
paramPreset      = input.string("Auto (chart TF)", "Param preset", options = ["Auto (chart TF)", "Daily", "15m scaled"], group = gDet, tooltip = "Auto = 15m scaled on a 15-minute chart, else Daily. 15m scaled = live /hot scanner (pivot 8, error 0.24%, span 10d). Daily = find_channels v1 numbers. Numeric Daily inputs below are ignored when 15m scaled is active.")
pivotLen         = input.int(15, "Pivot length", minval = 5, maxval = 40, group = gDet)
minBottomTouches = input.int(3, "Min bottom touches (classic)", minval = 2, maxval = 6, group = gDet)
minTopTouches    = input.int(2, "Min top touches", minval = 2, maxval = 5, group = gDet)
errorPct         = input.float(1.2, "Touch error %", minval = 0.2, maxval = 3.0, step = 0.1, group = gDet)
flatPct          = input.float(0.04, "Min support slope % / bar", minval = 0.01, maxval = 0.5, step = 0.01, group = gDet)
minTotalRisePct  = input.float(3.0, "Min total rise %", minval = 0.5, maxval = 20.0, step = 0.5, group = gDet)
minBarsApart     = input.int(15, "Min bars between swings", minval = 5, group = gDet)
minRallyPct      = input.float(4.0, "Min intervening rally %", minval = 1.0, maxval = 20.0, step = 0.5, group = gDet)
minPullbackPct   = input.float(3.0, "Min intervening pullback %", minval = 1.0, maxval = 20.0, step = 0.5, group = gDet)
maxViolationFrac = input.float(0.08, "Max support violation fraction", minval = 0.0, maxval = 0.25, step = 0.01, group = gDet)
maxLookbackPiv   = input.int(16, "Max pivot lows to scan", minval = 6, maxval = 30, group = gDet)
maxSpanDaysIn    = input.float(0.0, "Max L1-H2 span days (0=off)", minval = 0.0, step = 1.0, group = gDet)

keepLastOnly     = input.bool(false, "Keep only latest channel", group = gVis)
survivingOnly    = input.bool(true, "H2: surviving only (armed/waiting)", group = gVis, tooltip = "Prefer armed/waiting H2 (same idea as /hot). If none survive, still draw the latest H2 still inside the wait window so the table can show why it died. Off = draw every detected H2.")
extendLatest     = input.bool(true, "Extend latest rails right", group = gVis)
showFill         = input.bool(true, "Fill channel", group = gVis)
showTouches      = input.bool(true, "Show L/H touch labels (latest)", group = gVis)
showInfo         = input.bool(true, "Info table", group = gVis)
supportColor     = input.color(#26a69a, "Support", group = gVis)
resistColor      = input.color(#ef5350, "Resistance", group = gVis)
fillColor        = input.color(color.new(#26a69a, 88), "Fill", group = gVis)

is15mChart = timeframe.isminutes and timeframe.multiplier == 15
use15m = paramPreset == "15m scaled" or (paramPreset == "Auto (chart TF)" and is15mChart)
useH2  = setupMode == "H2 arm 2L/2H"
effPivot     = use15m ? 8 : pivotLen
effMinBottom = useH2 ? 2 : minBottomTouches
effMinTop    = minTopTouches
effError     = use15m ? 0.24 : errorPct
effFlat      = use15m ? 0.0015 : flatPct
effRise      = use15m ? 0.59 : minTotalRisePct
effMinBars   = use15m ? 8 : minBarsApart
effRally     = use15m ? 0.78 : minRallyPct
effPullback  = use15m ? 0.59 : minPullbackPct
effMaxPiv    = use15m ? 24 : useH2 ? 24 : maxLookbackPiv
effMaxSpanDays = use15m and maxSpanDaysIn <= 0 ? 10.0 : maxSpanDaysIn
effMinWait = use15m ? 12 : 6
effMaxWait = 252

var array<float> barHigh    = array.new_float()
var array<float> barLow     = array.new_float()
var array<float> barClose   = array.new_float()
var array<int>   barTime    = array.new_int()
var array<int>   lowBars    = array.new_int()
var array<float> lowPrices  = array.new_float()
var array<int>   highBars   = array.new_int()
var array<float> highPrices = array.new_float()
var array<int>   workTouchBars = array.new_int()
var array<float> workTouchPx   = array.new_float()
var array<float> workWidths     = array.new_float()
var array<int>   workCand       = array.new_int()
var array<int>   workFiltered    = array.new_int()
var array<int>   workUpper       = array.new_int()
var array<int>   bestTouchBars = array.new_int()
var array<float> bestTouchPx   = array.new_float()
var array<int>   bestUpper     = array.new_int()
var array<int>   anyTouchBars = array.new_int()
var array<float> anyTouchPx   = array.new_float()
var array<int>   anyUpper     = array.new_int()
var array<line>  drawnLines = array.new_line()
var array<label> drawnLabs = array.new_label()
var array<linefill> drawnFills = array.new_linefill()
var int lastPatternEnd = na
var line lastBot = na
var line lastTop = na
var int channelCount = 0
var int lastLowTouches = 0
var int lastHighTouches = 0
var float lastViolFrac = 0.0
var float lastWidthPct = 0.0
var int lastSpan = 0
var int lastX0 = na
var float lastY0 = na
var float lastSlope = na
var float lastWidth = na
var string lastStatus = ""
var int lastH2x = na
var int lastNDet = 0
var int lastNAlive = 0
var table info = table.new(position.top_right, 2, 11, bgcolor = color.new(#111111, 10), border_width = 1, border_color = color.new(#ffffff, 70))

f_clear() =>
    nF = array.size(drawnFills)
    if nF > 0
        for i = 0 to nF - 1
            linefill.delete(array.get(drawnFills, i))
        array.clear(drawnFills)
    nL = array.size(drawnLines)
    if nL > 0
        for i = 0 to nL - 1
            line.delete(array.get(drawnLines, i))
        array.clear(drawnLines)
    nB = array.size(drawnLabs)
    if nB > 0
        for i = 0 to nB - 1
            label.delete(array.get(drawnLabs, i))
        array.clear(drawnLabs)

f_push_cap(array<int> arrInt, array<float> arrFloat, int bar, float px, int cap) =>
    array.push(arrInt, bar)
    array.push(arrFloat, px)
    while array.size(arrInt) > cap
        array.shift(arrInt)
        array.shift(arrFloat)

f_trim_highs() =>
    if array.size(lowBars) > 0
        minX = array.get(lowBars, 0)
        while array.size(highBars) > 0 and array.get(highBars, 0) < minX
            array.shift(highBars)
            array.shift(highPrices)

f_line_at(float y1, int x1, float slope, int x) =>
    y1 + slope * (x - x1)

f_touch_ok(float yHat, float px, float err) =>
    px > 0 and math.abs(yHat - px) / px * 100.0 <= err

f_max_high(int x0, int x1) =>
    mx = float(na)
    if x1 > x0 + 1
        mx := array.get(barHigh, x0 + 1)
        if x1 - 1 > x0 + 1
            for i = x0 + 2 to x1 - 1
                mx := math.max(mx, array.get(barHigh, i))
    mx

f_min_low(int x0, int x1) =>
    mn = float(na)
    if x1 > x0 + 1
        mn := array.get(barLow, x0 + 1)
        if x1 - 1 > x0 + 1
            for i = x0 + 2 to x1 - 1
                mn := math.min(mn, array.get(barLow, i))
    mn

f_rally_ok(int xA, int xB, float supportAtA, float minPct) =>
    peak = f_max_high(xA, xB)
    not na(peak) and supportAtA > 0 and (peak - supportAtA) / supportAtA * 100.0 >= minPct

f_pullback_ok(int xA, int xB, float resistAtA, float minPct) =>
    trough = f_min_low(xA, xB)
    not na(trough) and resistAtA > 0 and (resistAtA - trough) / resistAtA * 100.0 >= minPct

f_sort_asc(array<float> a) =>
    n = array.size(a)
    if n > 1
        for i = 1 to n - 1
            key = array.get(a, i)
            j = i - 1
            while j >= 0 and array.get(a, j) > key
                array.set(a, j + 1, array.get(a, j))
                j -= 1
            array.set(a, j + 1, key)

f_viol_frac(int x1, int xn, float y1, float slope, float err) =>
    viol = 0
    total = 0
    if xn >= x1
        for i = x1 to xn
            total += 1
            sup = f_line_at(y1, x1, slope, i)
            if array.get(barClose, i) < sup * (1.0 - err / 100.0)
                viol += 1
    total > 0 ? viol / float(total) : 1.0

f_span_days(int x0, int x1) =>
    (array.get(barTime, x1) - array.get(barTime, x0)) / 86400000.0

f_l3_touch(int i, float sup, float err) =>
    hi = array.get(barHigh, i)
    lo = array.get(barLow, i)
    cl = array.get(barClose, i)
    tol = err / 100.0
    lo <= sup * (1.0 + tol) and hi >= sup * (1.0 - tol) and hi >= sup and cl >= sup * (1.0 - tol)

// Port of walk_h2_resist_asof: armed / waiting survive; filled / cancelled / expired do not.
f_h2_status(int x0, float y0, float slope, float width, int h2x, int asof, float err, int minW, int maxW) =>
    wait = asof - h2x
    st = wait < minW ? "waiting" : "armed"
    if wait > maxW
        st := "expired"
    else if h2x + 1 <= asof
        end = math.min(asof, h2x + maxW)
        for i = h2x + 1 to end
            if st != "waiting" and st != "armed"
                break
            sup = f_line_at(y0, x0, slope, i)
            resist = sup + width
            if i > 0 and array.get(barClose, i - 1) < f_line_at(y0, x0, slope, i - 1) * (1.0 - err / 100.0)
                st := "cancelled"
                break
            close_i = array.get(barClose, i)
            if close_i > resist * (1.0 + err / 100.0)
                if i >= h2x + minW
                    st := i < asof ? "filled_earlier" : "filled"
                    break
            else
                broke = close_i < sup * (1.0 - err / 100.0)
                if i < h2x + minW
                    if f_l3_touch(i, sup, err) or broke
                        st := "cancelled"
                        break
                else if broke
                    st := "cancelled"
                    break
    st

f_copy_int(array<int> src, array<int> dst) =>
    array.clear(dst)
    n = array.size(src)
    if n > 0
        for i = 0 to n - 1
            array.push(dst, array.get(src, i))

f_copy_float(array<float> src, array<float> dst) =>
    array.clear(dst)
    n = array.size(src)
    if n > 0
        for i = 0 to n - 1
            array.push(dst, array.get(src, i))

f_draw(int x1, float y1, int xn, float yn, float width, array<int> tBars, array<float> tPx, array<int> uBars, float slope, bool asLatest, string tag) =>
    ext = extendLatest and asLatest ? extend.right : extend.none
    lnBot = line.new(x1, y1, xn, yn, xloc = xloc.bar_index, extend = ext, color = supportColor, width = 2)
    lnTop = line.new(x1, y1 + width, xn, yn + width, xloc = xloc.bar_index, extend = ext, color = resistColor, width = 2)
    array.push(drawnLines, lnBot)
    array.push(drawnLines, lnTop)
    if showFill
        array.push(drawnFills, linefill.new(lnBot, lnTop, fillColor))
    nLtouch = array.size(tBars)
    nHtouch = array.size(uBars)
    if asLatest
        yLab = yn + width
        array.push(drawnLabs, label.new(xn, yLab, tag + str.tostring(nLtouch) + "L / " + str.tostring(nHtouch) + "H", style = label.style_label_down, color = color.new(supportColor, 15), textcolor = color.white, size = size.small))
        if showTouches
            if nLtouch > 0
                for ti = 0 to nLtouch - 1
                    array.push(drawnLabs, label.new(array.get(tBars, ti), array.get(tPx, ti), "L" + str.tostring(ti + 1), style = label.style_label_up, color = supportColor, textcolor = color.white, size = size.tiny))
            if nHtouch > 0
                for ui = 0 to nHtouch - 1
                    xb = array.get(uBars, ui)
                    yb = f_line_at(y1, x1, slope, xb) + width
                    array.push(drawnLabs, label.new(xb, yb, "H" + str.tostring(ui + 1), style = label.style_label_down, color = resistColor, textcolor = color.white, size = size.tiny))
    [lnBot, lnTop]

ph = ta.pivothigh(high, effPivot, effPivot)
pl = ta.pivotlow(low, effPivot, effPivot)
volMa20 = ta.sma(volume, 20)
volRelPrior = volMa20[1] > 0 ? volume[1] / volMa20[1] : float(na)

array.push(barHigh, high)
array.push(barLow, low)
array.push(barClose, close)
array.push(barTime, time)

if not na(pl)
    f_push_cap(lowBars, lowPrices, bar_index - effPivot, pl, effMaxPiv)
    f_trim_highs()
if not na(ph)
    f_push_cap(highBars, highPrices, bar_index - effPivot, ph, effMaxPiv * 2)
    f_trim_highs()

// Classic find_channels v1: >=3 lows, highs strictly between first and last low.
if not useH2 and not na(pl) and array.size(lowBars) >= effMinBottom
    nL = array.size(lowBars)
    for a = 0 to nL - effMinBottom
        for c = a + effMinBottom - 1 to nL - 1
            x1 = array.get(lowBars, a)
            y1 = array.get(lowPrices, a)
            xn = array.get(lowBars, c)
            yn = array.get(lowPrices, c)
            if xn - x1 < effMinBars * (effMinBottom - 1)
                continue
            if not na(lastPatternEnd) and x1 <= lastPatternEnd
                continue
            if y1 <= 0 or yn <= 0
                continue
            slope = (yn - y1) / float(xn - x1)
            risePct = (yn - y1) / y1 * 100.0
            if slope <= 0.0 or (slope / y1 * 100.0) < effFlat or risePct < effRise
                continue

            array.clear(workTouchBars)
            array.clear(workTouchPx)
            array.push(workTouchBars, x1)
            array.push(workTouchPx, y1)
            swingsOk = true

            for m = a + 1 to c - 1
                xm = array.get(lowBars, m)
                ym = array.get(lowPrices, m)
                prevX = array.get(workTouchBars, array.size(workTouchBars) - 1)
                prevY = array.get(workTouchPx, array.size(workTouchPx) - 1)
                if xm - prevX < effMinBars
                    continue
                if not f_touch_ok(f_line_at(y1, x1, slope, xm), ym, effError)
                    continue
                if ym < prevY * 0.995
                    continue
                if not f_rally_ok(prevX, xm, prevY, effRally)
                    continue
                array.push(workTouchBars, xm)
                array.push(workTouchPx, ym)

            prevX = array.get(workTouchBars, array.size(workTouchBars) - 1)
            prevY = array.get(workTouchPx, array.size(workTouchPx) - 1)
            if xn != prevX
                if xn - prevX < effMinBars
                    swingsOk := false
                else if not f_touch_ok(f_line_at(y1, x1, slope, xn), yn, effError)
                    swingsOk := false
                else if yn < prevY * 0.995
                    swingsOk := false
                else if not f_rally_ok(prevX, xn, prevY, effRally)
                    swingsOk := false
                else
                    array.push(workTouchBars, xn)
                    array.push(workTouchPx, yn)

            if not swingsOk or array.size(workTouchBars) < effMinBottom
                continue

            x1 := array.get(workTouchBars, 0)
            y1 := array.get(workTouchPx, 0)
            xn := array.get(workTouchBars, array.size(workTouchBars) - 1)
            yn := array.get(workTouchPx, array.size(workTouchPx) - 1)
            slope := (yn - y1) / float(xn - x1)

            array.clear(workWidths)
            nH = array.size(highBars)
            if nH > 0
                for hi = 0 to nH - 1
                    xh = array.get(highBars, hi)
                    if xh <= x1 or xh >= xn
                        continue
                    dist = array.get(highPrices, hi) - f_line_at(y1, x1, slope, xh)
                    if dist > 0
                        array.push(workWidths, dist)
            if array.size(workWidths) < effMinTop
                continue
            f_sort_asc(workWidths)

            chosenWidth = float(na)
            array.clear(workUpper)
            for wi = 0 to array.size(workWidths) - 1
                width = array.get(workWidths, wi)
                array.clear(workCand)
                if nH > 0
                    for hi = 0 to nH - 1
                        xh = array.get(highBars, hi)
                        if xh <= x1 or xh >= xn
                            continue
                        yh = array.get(highPrices, hi)
                        yTop = f_line_at(y1, x1, slope, xh) + width
                        if f_touch_ok(yTop, yh, effError * 1.25)
                            array.push(workCand, xh)
                if array.size(workCand) < effMinTop
                    continue
                array.clear(workFiltered)
                array.push(workFiltered, array.get(workCand, 0))
                if array.size(workCand) > 1
                    for ci = 1 to array.size(workCand) - 1
                        xh = array.get(workCand, ci)
                        prevH = array.get(workFiltered, array.size(workFiltered) - 1)
                        if xh - prevH < effMinBars
                            continue
                        resistPrev = f_line_at(y1, x1, slope, prevH) + width
                        if f_pullback_ok(prevH, xh, resistPrev, effPullback)
                            array.push(workFiltered, xh)
                if array.size(workFiltered) >= effMinTop
                    chosenWidth := width
                    array.clear(workUpper)
                    if array.size(workFiltered) > 0
                        for ui = 0 to array.size(workFiltered) - 1
                            array.push(workUpper, array.get(workFiltered, ui))
                    break

            if na(chosenWidth)
                continue

            violFrac = f_viol_frac(x1, xn, y1, slope, effError)
            if violFrac > maxViolationFrac
                continue

            if keepLastOnly
                f_clear()
                lastBot := na
                lastTop := na
            else if extendLatest and not na(lastBot)
                line.set_extend(lastBot, extend.none)
                line.set_extend(lastTop, extend.none)
            [lnBotDraw, lnTopDraw] = f_draw(x1, y1, xn, yn, chosenWidth, workTouchBars, workTouchPx, workUpper, slope, true, "Channel ")
            lastBot := lnBotDraw
            lastTop := lnTopDraw
            lastLowTouches := array.size(workTouchBars)
            lastHighTouches := array.size(workUpper)
            lastViolFrac := violFrac
            lastWidthPct := y1 > 0 ? chosenWidth / y1 * 100.0 : 0.0
            lastSpan := xn - x1
            lastX0 := x1
            lastY0 := y1
            lastSlope := slope
            lastWidth := chosenWidth
            lastPatternEnd := xn
            channelCount += 1
            alert("Channel Touch: ascending channel confirmed", alert.freq_once_per_bar)

// H2 arm = find_h2_l3_setups. As-of the chart head so survival matches /hot.
// Replay: barstate.islast can stay on the live last bar that the playhead never
// reaches, so line.new never redraws. islastconfirmedhistory is the playhead.
h2Head = barstate.islast or barstate.islastconfirmedhistory
if useH2 and h2Head and array.size(lowBars) >= 2
    f_clear()
    lastBot := na
    lastTop := na
    lastPatternEnd := na
    channelCount := 0
    lastStatus := ""
    lastH2x := na
    lastNDet := 0
    lastNAlive := 0
    bestH2 = int(na)
    bestX1 = 0
    bestY1 = 0.0
    bestSlope = 0.0
    bestW = 0.0
    bestViol = 0.0
    bestSt = ""
    anyH2 = int(na)
    anyX1 = 0
    anyY1 = 0.0
    anySlope = 0.0
    anyW = 0.0
    anyViol = 0.0
    anySt = ""
    nL = array.size(lowBars)
    nH = array.size(highBars)
    asof = bar_index
    nDet = 0
    nAlive = 0
    if nL >= 2
        for c = nL - 1 to 1
            for a = c - 1 to 0
                x1 = array.get(lowBars, a)
                y1 = array.get(lowPrices, a)
                xn = array.get(lowBars, c)
                yn = array.get(lowPrices, c)
                if xn - x1 < effMinBars
                    continue
                if y1 <= 0 or yn <= 0
                    continue
                slope = (yn - y1) / float(xn - x1)
                risePct = (yn - y1) / y1 * 100.0
                if slope <= 0.0 or (slope / y1 * 100.0) < effFlat or risePct < effRise
                    continue
                if not f_touch_ok(f_line_at(y1, x1, slope, xn), yn, effError)
                    continue
                if yn < y1 * 0.995
                    continue
                if not f_rally_ok(x1, xn, y1, effRally)
                    continue

                nInside = 0
                nAfter = 0
                array.clear(workWidths)
                if nH > 0
                    for hi = 0 to nH - 1
                        xh = array.get(highBars, hi)
                        if xh > x1 and xh < xn
                            nInside += 1
                        else if xh > xn
                            nAfter += 1
                        if xh > x1
                            dist = array.get(highPrices, hi) - f_line_at(y1, x1, slope, xh)
                            if dist > 0
                                array.push(workWidths, dist)
                if nInside < 1 or nAfter < 1 or array.size(workWidths) < effMinTop
                    continue
                f_sort_asc(workWidths)

                chosenWidth = float(na)
                h2x = int(na)
                array.clear(workUpper)
                for wi = 0 to array.size(workWidths) - 1
                    width = array.get(workWidths, wi)
                    array.clear(workCand)
                    if nH > 0
                        for hi = 0 to nH - 1
                            xh = array.get(highBars, hi)
                            if xh <= x1
                                continue
                            yh = array.get(highPrices, hi)
                            yTop = f_line_at(y1, x1, slope, xh) + width
                            if f_touch_ok(yTop, yh, effError * 1.25)
                                array.push(workCand, xh)
                    hasAfter = false
                    if array.size(workCand) > 0
                        for ci = 0 to array.size(workCand) - 1
                            if array.get(workCand, ci) > xn
                                hasAfter := true
                                break
                    if not hasAfter or array.size(workCand) < effMinTop
                        continue
                    array.clear(workFiltered)
                    array.push(workFiltered, array.get(workCand, 0))
                    if array.size(workCand) > 1
                        for ci = 1 to array.size(workCand) - 1
                            xh = array.get(workCand, ci)
                            prevH = array.get(workFiltered, array.size(workFiltered) - 1)
                            if xh - prevH < effMinBars
                                continue
                            resistPrev = f_line_at(y1, x1, slope, prevH) + width
                            if f_pullback_ok(prevH, xh, resistPrev, effPullback)
                                array.push(workFiltered, xh)
                    if array.size(workFiltered) < effMinTop
                        continue
                    h2Cand = int(na)
                    if array.size(workFiltered) > 0
                        for ui = 0 to array.size(workFiltered) - 1
                            h = array.get(workFiltered, ui)
                            if h <= xn
                                continue
                            if ui + 1 >= effMinTop
                                h2Cand := h
                                break
                    if na(h2Cand)
                        continue
                    if effMaxSpanDays > 0 and f_span_days(x1, h2Cand) > effMaxSpanDays
                        continue
                    chosenWidth := width
                    h2x := h2Cand
                    array.clear(workUpper)
                    for ui = 0 to array.size(workFiltered) - 1
                        array.push(workUpper, array.get(workFiltered, ui))
                    break

                if na(chosenWidth) or na(h2x) or h2x >= asof
                    continue

                violFrac = f_viol_frac(x1, xn, y1, slope, effError)
                if violFrac > maxViolationFrac
                    continue
                nDet += 1

                st = f_h2_status(x1, y1, slope, chosenWidth, h2x, asof, effError, effMinWait, effMaxWait)
                array.clear(workTouchBars)
                array.clear(workTouchPx)
                array.push(workTouchBars, x1)
                array.push(workTouchPx, y1)
                array.push(workTouchBars, xn)
                array.push(workTouchPx, yn)
                if asof - h2x <= effMaxWait and (na(anyH2) or h2x >= anyH2)
                    anyH2 := h2x
                    anyX1 := x1
                    anyY1 := y1
                    anySlope := slope
                    anyW := chosenWidth
                    anyViol := violFrac
                    anySt := st
                    f_copy_int(workTouchBars, anyTouchBars)
                    f_copy_float(workTouchPx, anyTouchPx)
                    f_copy_int(workUpper, anyUpper)
                if survivingOnly and st != "armed" and st != "waiting"
                    continue
                nAlive += 1
                yH2 = f_line_at(y1, x1, slope, h2x)

                if keepLastOnly
                    if na(bestH2) or h2x >= bestH2
                        bestH2 := h2x
                        bestX1 := x1
                        bestY1 := y1
                        bestSlope := slope
                        bestW := chosenWidth
                        bestViol := violFrac
                        bestSt := st
                        f_copy_int(workTouchBars, bestTouchBars)
                        f_copy_float(workTouchPx, bestTouchPx)
                        f_copy_int(workUpper, bestUpper)
                else
                    if extendLatest and not na(lastBot)
                        line.set_extend(lastBot, extend.none)
                        line.set_extend(lastTop, extend.none)
                    [lnBotH2, lnTopH2] = f_draw(x1, y1, h2x, yH2, chosenWidth, workTouchBars, workTouchPx, workUpper, slope, true, "H2 ")
                    lastBot := lnBotH2
                    lastTop := lnTopH2
                    lastLowTouches := array.size(workTouchBars)
                    lastHighTouches := array.size(workUpper)
                    lastViolFrac := violFrac
                    lastWidthPct := y1 > 0 ? chosenWidth / y1 * 100.0 : 0.0
                    lastSpan := h2x - x1
                    lastX0 := x1
                    lastY0 := y1
                    lastSlope := slope
                    lastWidth := chosenWidth
                    lastPatternEnd := h2x
                    lastStatus := st
                    lastH2x := h2x
                    channelCount += 1

    lastNDet := nDet
    lastNAlive := nAlive
    pickAlive = not na(bestH2)
    useH2x = pickAlive ? bestH2 : anyH2
    useX1 = pickAlive ? bestX1 : anyX1
    useY1 = pickAlive ? bestY1 : anyY1
    useSlope = pickAlive ? bestSlope : anySlope
    useW = pickAlive ? bestW : anyW
    useViol = pickAlive ? bestViol : anyViol
    useSt = pickAlive ? bestSt : anySt
    if keepLastOnly and not na(useH2x)
        yH2b = f_line_at(useY1, useX1, useSlope, useH2x)
        if pickAlive
            [lnBotB, lnTopB] = f_draw(useX1, useY1, useH2x, yH2b, useW, bestTouchBars, bestTouchPx, bestUpper, useSlope, true, "H2 ")
            lastBot := lnBotB
            lastTop := lnTopB
            lastLowTouches := array.size(bestTouchBars)
            lastHighTouches := array.size(bestUpper)
        else
            [lnBotF, lnTopF] = f_draw(useX1, useY1, useH2x, yH2b, useW, anyTouchBars, anyTouchPx, anyUpper, useSlope, true, "H2 ")
            lastBot := lnBotF
            lastTop := lnTopF
            lastLowTouches := array.size(anyTouchBars)
            lastHighTouches := array.size(anyUpper)
        lastViolFrac := useViol
        lastWidthPct := useY1 > 0 ? useW / useY1 * 100.0 : 0.0
        lastSpan := useH2x - useX1
        lastX0 := useX1
        lastY0 := useY1
        lastSlope := useSlope
        lastWidth := useW
        lastPatternEnd := useH2x
        lastStatus := useSt
        lastH2x := useH2x
        channelCount := 1
    else if not keepLastOnly and channelCount == 0 and not na(anyH2)
        yH2b = f_line_at(anyY1, anyX1, anySlope, anyH2)
        [lnBotB, lnTopB] = f_draw(anyX1, anyY1, anyH2, yH2b, anyW, anyTouchBars, anyTouchPx, anyUpper, anySlope, true, "H2 ")
        lastBot := lnBotB
        lastTop := lnTopB
        lastLowTouches := array.size(anyTouchBars)
        lastHighTouches := array.size(anyUpper)
        lastViolFrac := anyViol
        lastWidthPct := anyY1 > 0 ? anyW / anyY1 * 100.0 : 0.0
        lastSpan := anyH2 - anyX1
        lastX0 := anyX1
        lastY0 := anyY1
        lastSlope := anySlope
        lastWidth := anyW
        lastPatternEnd := anyH2
        lastStatus := anySt
        lastH2x := anyH2
        channelCount := 1

if h2Head
    if showInfo
        resistNow = not na(lastX0) ? f_line_at(lastY0, lastX0, lastSlope, bar_index) + lastWidth : float(na)
        modeTxt = (useH2 ? "H2" : "3L") + (use15m ? " 15m" : " 1d")
        warn15m = is15mChart and not use15m
        waitBars = not na(lastH2x) ? bar_index - lastH2x : int(na)
        waitLeft = not na(waitBars) ? math.max(0, effMinWait - waitBars) : int(na)
        fillLvl = not na(resistNow) ? resistNow * (1.0 + effError / 100.0) : float(na)
        fillTxt = "switch to H2 arm"
        gateTxt = na(fillLvl) ? "C>resist*(1+" + str.tostring(effError / 100.0, "#.000") + ") wait>=" + str.tostring(effMinWait) : "C>" + str.tostring(fillLvl, "#.00") + " wait>=" + str.tostring(effMinWait)
        if use15m
            gateTxt := gateTxt + " vol>=2"
        detBit = str.tostring(lastNAlive) + "a/" + str.tostring(lastNDet) + "d"
        if useH2
            if channelCount == 0
                fillTxt := lastNDet == 0 ? "no H2 found" : detBit + " " + gateTxt
            else if lastStatus == "filled"
                fillTxt := "filled " + detBit
            else if lastStatus == "cancelled" or lastStatus == "expired" or lastStatus == "filled_earlier"
                fillTxt := lastStatus + " " + detBit + " " + gateTxt
            else if not na(waitLeft) and waitLeft > 0
                fillTxt := "wait " + str.tostring(waitLeft) + " more; " + gateTxt
            else if not na(fillLvl)
                closeBit = close > fillLvl ? "C ok" : "need C>" + str.tostring(fillLvl, "#.00")
                if use15m
                    volBit = na(volRelPrior) ? " vol?" : volRelPrior >= 2.0 ? " vol ok" : " vol" + str.tostring(volRelPrior, "#.00") + "<2"
                    fillTxt := closeBit + volBit
                else
                    fillTxt := closeBit
            else
                fillTxt := lastStatus == "" ? "-" : lastStatus
        waitTxt = na(waitBars) ? "-" : str.tostring(waitBars) + "/" + str.tostring(effMinWait)
        lab = #ffffff
        sz = size.small
        table.cell(info, 0, 0, "CTD", text_color = lab, text_size = sz)
        table.cell(info, 1, 0, warn15m ? "set 15m scaled" : modeTxt + " " + detBit, text_color = warn15m ? color.yellow : lab, text_size = sz)
        table.cell(info, 0, 1, "Lows", text_color = lab, text_size = sz)
        table.cell(info, 1, 1, str.tostring(lastLowTouches), text_color = supportColor, text_size = sz)
        table.cell(info, 0, 2, "Highs", text_color = lab, text_size = sz)
        table.cell(info, 1, 2, str.tostring(lastHighTouches), text_color = resistColor, text_size = sz)
        table.cell(info, 0, 3, "Width %", text_color = lab, text_size = sz)
        table.cell(info, 1, 3, str.tostring(lastWidthPct, "#.00"), text_color = lab, text_size = sz)
        table.cell(info, 0, 4, "Viol frac", text_color = lab, text_size = sz)
        table.cell(info, 1, 4, str.tostring(lastViolFrac, "#.000"), text_color = lab, text_size = sz)
        table.cell(info, 0, 5, "Span bars", text_color = lab, text_size = sz)
        table.cell(info, 1, 5, str.tostring(lastSpan), text_color = lab, text_size = sz)
        table.cell(info, 0, 6, "Resist now", text_color = lab, text_size = sz)
        table.cell(info, 1, 6, na(resistNow) ? "-" : str.tostring(resistNow, "#.00"), text_color = resistColor, text_size = sz)
        table.cell(info, 0, 7, "Wait", text_color = lab, text_size = sz)
        table.cell(info, 1, 7, waitTxt, text_color = lab, text_size = sz)
        table.cell(info, 0, 8, "H2 status", text_color = lab, text_size = sz)
        table.cell(info, 1, 8, lastStatus == "" ? "-" : lastStatus, text_color = lastStatus == "armed" ? supportColor : lastStatus == "waiting" ? color.yellow : lab, text_size = sz)
        table.cell(info, 0, 9, "Fill", text_color = lab, text_size = sz)
        table.cell(info, 1, 9, fillTxt, text_color = lastStatus == "armed" or lastStatus == "waiting" ? color.yellow : lab, text_size = sz)
        table.cell(info, 0, 10, "Pivot", text_color = lab, text_size = sz)
        table.cell(info, 1, 10, str.tostring(effPivot) + " err" + str.tostring(effError, "#.00"), text_color = lab, text_size = sz)
    else
        table.clear(info, 0, 0)
